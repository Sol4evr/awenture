{
  "version": "aw-qf-1.0.1",
  "projectRef": "yvvwjdnazxzhzrfhudwx",
  "topupIntakeFunction": "topup-request",
  "processorFunction": "question-factory",
  "releaseFunction": "question-release",
  "releasedBankFunction": "released-bank",
  "privateSchema": "awenture_private",
  "tables": {
    "requests": "question_topup_requests",
    "batches": "question_topup_batches",
    "runs": "question_factory_runs",
    "candidates": "question_factory_candidates",
    "released": "released_question_items"
  },
  "states": {
    "request": ["queued", "generating", "expert_review", "released", "review_failed", "complete"],
    "run": ["generating", "expert_review", "complete", "failed"],
    "automatedCandidate": ["pending", "passed", "rejected"],
    "expertCandidate": ["pending", "approved", "rejected"]
  },
  "mandatoryPolicy": {
    "expertReviewRequired": true,
    "visualQaRequired": true,
    "noveltyCheckRequired": true,
    "releaseGateRequired": true,
    "dualPassServerRelease": true,
    "learnerRuntimeDirectPublish": false
  },
  "automatedChecks": [
    "metadata",
    "thin_stem",
    "four_distinct_options",
    "answer_key",
    "rationale",
    "accessible_visual",
    "banned_language",
    "within_batch_semantic_sibling"
  ],
  "release": {
    "mode": "dual-pass-server-release",
    "independentReviewer": "aw-independent-review-1.0.0",
    "releaseGate": "aw-content-release-1.0.0",
    "feed": "aw-dynamic-bank-1",
    "browserWriteAccess": false,
    "practiceAutoSync": true
  },
  "releaseBoundary": "Only candidates that pass the factory automated gate and the independent server release reviewer may enter the private released bank. The learner browser has no publish or table-write privilege; Practice consumes only the read-only dual-pass released feed.",
  "idempotency": "request_key + generator_version yields one logical factory run; candidate_key is deterministic per request/subject/index/version and unique in the released bank.",
  "generation": {
    "mode": "governed-parameterised-recipes",
    "providerCost": 0,
    "maxCandidatesPerSubjectPerRun": 40,
    "correctOptionTracking": "post-shuffle-index",
    "subjects": ["English", "Mathematics", "Science"]
  }
}
